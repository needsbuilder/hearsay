# Local development stand-in ONLY. Hearsay is built to run on Nebius Token
# Factory with NVIDIA Nemotron models (see .env.example). This file points the
# same OpenAI-compatible client at a local Ollama server so the pipeline can be
# developed and tested before the Token Factory key exists.
HEARSAY_LLM_BASE_URL=http://localhost:11434/v1
HEARSAY_LLM_API_KEY=ollama
HEARSAY_EXTRACT_MODEL=qwen2.5:7b
HEARSAY_JUDGE_MODELS=qwen2.5:3b,qwen2.5:7b
HEARSAY_ADJUDICATOR_MODEL=qwen2.5:7b

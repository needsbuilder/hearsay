# Copy to .env and fill in. Never commit .env.

# Model endpoint: Nebius Token Factory (OpenAI-compatible).
HEARSAY_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
HEARSAY_LLM_API_KEY=<nebius-token-factory-api-key>

# Model ids are placeholders until the Token Factory key exists; read the real
# ids from GET https://api.tokenfactory.nebius.com/v1/models.
# Extraction: one NVIDIA Nemotron model.
HEARSAY_EXTRACT_MODEL=<nemotron-model-id-for-extraction>
# Jury: distinct Nemotron models, comma separated.
HEARSAY_JUDGE_MODELS=<nemotron-judge-model-id-1>,<nemotron-judge-model-id-2>,<nemotron-judge-model-id-3>
# Adjudicator: a larger Nemotron model, used only when judges disagree.
HEARSAY_ADJUDICATOR_MODEL=<larger-nemotron-model-id>

# Tavily (documentation search and extraction).
TAVILY_API_KEY=<tavily-api-key>
# Refuse to make more than this many uncached Tavily calls in one run.
HEARSAY_TAVILY_MAX_CALLS=20

# On-disk cache for every HTTP, Tavily and model call ("off" disables it).
HEARSAY_CACHE_DIR=.hearsay-cache
